{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "nextjs", "import", "unicorn"],
  "categories": {
    "correctness": "off"
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/storybook-static/**",
    "**/.next/**",
    "**/out/**",
    "**/.consumer-*/**",
    "**/next-env.d.ts"
  ]
}
