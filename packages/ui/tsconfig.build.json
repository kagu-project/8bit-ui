  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "stripInternal": false,
    "noEmit": false
  },
  "exclude": ["src/**/*.stories.tsx", "src/**/*.test.tsx", "src/test/**"]
}
